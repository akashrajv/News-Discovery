# Application Configuration
APP_NAME=Multi-Source News Collection Engine
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true

# Database Configuration (PostgreSQL primary, SQLite fallback if unavailable or unconfigured)
# Example Postgres: postgresql://postgres:postgres@localhost:5432/news_db
# Example SQLite fallback: sqlite:///./news_engine.db
DATABASE_URL=sqlite:///./news_engine.db

# Cache Configuration (Redis primary, In-memory dictionary fallback if unavailable)
# Example Redis: redis://localhost:6379/0
REDIS_URL=
CACHE_TTL_SECONDS=300

# Permitted News API Keys (Optional - Engine defaults to RSS / Public feeds or DEMO_MODE if empty)
NEWSAPI_KEY=
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# Engine Settings
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0
